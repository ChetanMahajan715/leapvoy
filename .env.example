# Copy to .env (never commit .env). Pick your own strong password.
POSTGRES_USER=leapvoy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leapvoy

# Used by the backend when run on the laptop (outside Docker)
DATABASE_URL=postgresql+asyncpg://leapvoy:change-me@localhost:5432/leapvoy
# Throwaway DB for tests: tests wipe and re-create its tables
TEST_DATABASE_URL=postgresql+asyncpg://leapvoy:change-me@localhost:5432/leapvoy_test

# Encrypts Telegram sessions / App Passwords. Generate: cd backend; uv run python -m app.telegram.cli keygen
MASTER_KEY=
# From https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

LOG_LEVEL=INFO
LOG_JSON=false

# Signs app login tokens: cd backend; uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Leapvoy system emails (password reset codes): Gmail + App Password
SYSTEM_EMAIL=
SYSTEM_EMAIL_PASSWORD=

# AI providers (free tiers). Groq first; Mistral (Ministral models) and Gemini are the backups.
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Public server safety. SIGNUP_MODE: open (anyone) | first (only the first account, then closed) | closed
SIGNUP_MODE=open
# Interactive API docs at /docs. Set false on a server reachable from the internet.
API_DOCS=true
